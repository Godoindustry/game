# ===== Linha de Sobrevivência — variáveis de ambiente =====
# Copie para .env.local e ajuste. Nunca faça commit de .env.local.

# URL pública do app (usada em links de e-mail, convites e OAuth)
APP_URL=http://localhost:3000
# Arquivo do banco SQLite (criado automaticamente)
DATABASE_PATH=./data/linha.sqlite

# ADM MASTER inicial — criado/promovido no boot. É a ÚNICA forma de existir um master.
ADMIN_EMAIL=admin@linha.local
ADMIN_PASSWORD=TroqueEstaSenha123
# Opcional: nome de usuário para entrar no lugar do e-mail
ADMIN_USERNAME=

# Sessão
SESSION_TTL_HOURS=168
# COOKIE_SECURE=true   # padrão: true em produção

# Google OAuth (opcional). Redirect autorizado: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Premium: quantos primeiros cadastros ganham premium
PREMIUM_EARLY_SLOTS=12
FREE_MAX_ACTIVE_CAMPAIGNS=3
PREMIUM_MAX_ACTIVE_CAMPAIGNS=12

# Tempo real de espera: segundos reais por minuto de jogo (0.5 → "procurar" de 10 min espera 5 s), com teto
ACTION_REAL_SECONDS_PER_GAME_MINUTE=0.5
ACTION_MAX_REAL_SECONDS=60
# Multiplayer: prazo da rodada e detecção de pausa (todos offline)
ROUND_TIMEOUT_SECONDS=300
PAUSE_AFTER_SECONDS=60

# ===== IA (opcional — o jogo funciona 100% sem ela) =====
# mock | chain | openai_compatible | anthropic | none
# chain = tenta os provedores gratuitos na ordem de AI_CHAIN (só os que têm chave); se todos falharem → texto predefinido
AI_PROVIDER=mock
AI_CHAIN=groq,openrouter,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# openai_compatible: qualquer API /chat/completions (Groq, OpenRouter, Ollama, Gemini-compat...)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant
# anthropic: modelo padrão claude-opus-5; para custo menor use AI_MODEL=claude-haiku-4-5
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=6000
AI_MAX_OUTPUT_TOKENS=220
AI_MAX_PROMPT_CHARS=2400
AI_CACHE_TTL_HOURS=72
# Orçamento diário global (US$) e preço por milhão de tokens do modelo escolhido (para registrar custo)
AI_DAILY_BUDGET_USD=1
AI_COST_INPUT_PER_MTOK=0
AI_COST_OUTPUT_PER_MTOK=0
AI_USER_DAILY_REQUESTS=40
AI_PREMIUM_DAILY_REQUESTS=400
